# Copy to apps/web/.env.local (gitignored). Placeholders only.

# --- Live demo (/demo, /api/demo/*) ---
# Gemini drives the three role agents + intent parser. Without a key they fall back to a
# deterministic heuristic (llmModel null).
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
LLM_PROVIDER_ORDER=gemini
# stellar-mainnet (Horizon pubnet SDEX, Binance fallback) — demo default
MARKET_DATA_SOURCE=stellar-mainnet

# --- Backend wiring (dashboard + smart-wallet onboarding) ---
NEXT_PUBLIC_AGENTS_BACKEND_URL=http://localhost:4001
AGENTS_BACKEND_URL=http://localhost:4001

# --- Soroban contracts (testnet) — values from configs/contracts.testnet.json after `pnpm deploy:testnet`
STELLAR_NETWORK=testnet
DELEGATION_MANAGER_CONTRACT_ID=
POLICY_CONTRACT_ID=
CUSTOM_ACCOUNT_CONTRACT_ID=
CUSTOM_ACCOUNT_WASM_HASH=
REGISTRY_CONTRACT_ID=

# Funded testnet secret ("S...") that sponsors smart-wallet deployment + registry writes.
# Server-side only. Testnet only — never use a mainnet key here.
FUNDER_SECRET_KEY=

# --- Optional ---
# NEXT_PUBLIC_MAINNET_USDC_ISSUER=
# OPENROUTER_API_KEY=
# LLM_MOCK=
